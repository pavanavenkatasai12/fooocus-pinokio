{
  "name": "Fooocus",
  "description": "Fooocus launcher",
  "run": [
    {
      "method": "shell.run",
      "params": {
        "cmd": [
          "git clone https://github.com/lllyasviel/Fooocus.git || true",
          "cd Fooocus",
          "pip install -r requirements_versions.txt",
          "python entry_with_update.py --always-high-vram"
        ]
      }
    }
  ]
}
