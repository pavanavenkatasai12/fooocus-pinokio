{
  "name": "Fooocus Auto Setup",
  "description": "Run Fooocus easily via Pinokio",
  "install": [
    "git clone https://github.com/lllyasviel/Fooocus.git app",
    "cd app",
    "pip install -r requirements_versions.txt"
  ],
  "run": [
    "cd app",
    "python entry_with_update.py --always-high-vram"
  ]
}
